# REFERENCE ONLY: do not deploy the long-running worker on a managed Hostinger web-app process.
# Use an independently supervised runtime, a restricted 'business_os_worker' database role,
# trusted TLS CA chain, and matching private environment-scoped secrets.
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info
AUTOMATION_WORKER_NAME=business-os-worker
AUTOMATION_DATABASE_URL=postgresql://RESTRICTED_WORKER_USERNAME:REPLACE_PASSWORD@YOUR_PROJECT_POSTGRES_HOST:5432/postgres?sslmode=verify-full
# Email is optional until the actual SMTP / Resend sender identity is configured.
# Both values must be set together or both omitted.
# AUTOMATION_EMAIL_API_KEY=REPLACE_WITH_PRIVATE_KEY
# AUTOMATION_EMAIL_FROM=verified@example.com
