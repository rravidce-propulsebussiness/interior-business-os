{
  "name": "business-os-public-company-sites",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  // Cloudflare for SaaS sends customer hostnames through the provider zone.
  // More-specific no-Worker routes for the provider apex/www and service hosts
  // must be preserved in Cloudflare; see docs/WEBSITE-CLOUDFLARE-EDGE.md.
  "routes": [
    {
      "pattern": "*/*",
      "zone_name": "sghomesinterior.in"
    }
  ]
}
