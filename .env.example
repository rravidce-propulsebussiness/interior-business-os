# Public shells run without configuration; authentication requires the two values below.
# Copy into apps/business-app/.env.local and apps/platform-admin/.env.local.
# Never put secret/service-role keys in NEXT_PUBLIC_* variables.
APP_ENV=development
# Hosted deployment must set APP_ENV and SUPABASE_ENVIRONMENT to staging or production.
SUPABASE_ENVIRONMENT=development
# Bare HTTPS app origin in hosted deployments; never substitute localhost.
APP_ORIGIN=
# Server-only 32 random bytes encoded as 64 lowercase hex. Separate key per app/environment.
# Encrypts short-lived pending reset tokens; never a Supabase credential or public key.
AUTH_RECOVERY_SIGNING_KEY=
# Structured log threshold: debug (development only), info, warn, error.
LOG_LEVEL=info
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# No Supabase service-role key is used by either application.
# Server-only quotation integrity key: 64 lowercase hex characters; mirror in the private DB key table.
# Generate locally and configure using docs/QUOTATIONS.md. Never use NEXT_PUBLIC_.
QUOTATION_SIGNING_KEY=
# Set in your shell for db:verify / db:test / db:types, never in a browser environment:
# TEST_DATABASE_URL=postgresql://.../a_new_disposable_test_database
# ALLOW_TEST_DATABASE_RESET=yes
# PSQL_PATH=absolute/path/to/psql (optional; PATH on Unix, PostgreSQL 18 path on Windows)
# Optional live Playwright tests (confirmed disposable development account):
# E2E_LIVE_SUPABASE=true
# E2E_OWNER_EMAIL=owner@example.test
# E2E_OWNER_PASSWORD=local-only-value
# E2E_DESIGNER_EMAIL=designer@example.test
# E2E_DESIGNER_PASSWORD=local-only-value


# Phase 4 hosted sales acceptance (see docs/SUPABASE.md for grants and seeds):
# E2E_LIVE_CRM=true
# E2E_SALES_EMAIL=sales@example.test
# E2E_SALES_PASSWORD=local-only-value

# Phase 8 server-only website integrity key; provision matching private DB key.
# See docs/WEBSITE-SECURITY.md. Public renderer must never receive this value.
WEBSITE_BUILD_KEY_ID=primary
WEBSITE_BUILD_SIGNING_KEY=

# Phase 9: absolute HTTPS origin of the Websites app hosting public brochures.
# Configure the same origin in Business App and Websites. No Website subscription required.
BROCHURE_PUBLIC_ORIGIN=
# Server-only signing key; matching ID/UTF-8 secret in private.website_build_keys.
# If omitted, the existing Website signing configuration is reused as infrastructure.
BROCHURE_BUILD_KEY_ID=primary
BROCHURE_BUILD_SIGNING_KEY=
# Opt-in disposable hosted acceptance (Website disabled; Brochure + CRM enabled):
# E2E_LIVE_BROCHURE=true
# E2E_BROCHURE_PUBLIC_ORIGIN=https://public-development.example.test
# Uses the E2E_OWNER_EMAIL / E2E_OWNER_PASSWORD variables above.

# Phase 10 worker-only environment; never add NEXT_PUBLIC prefixes.
AUTOMATION_DATABASE_URL=
AUTOMATION_WORKER_NAME=automation-worker
AUTOMATION_EMAIL_API_KEY=
AUTOMATION_EMAIL_FROM=
# E2E_LIVE_AUTOMATION=true

# Optional self-service tenant custom-domain SSL through Cloudflare for SaaS.
# Business App server only. Requires a configured SaaS zone, fallback origin
# and a CNAME target matching the Website Platform base domain.
# Never use NEXT_PUBLIC_ for the API token.
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_API_TOKEN=
