# Standalone acceptance runner only. Never load this file into deployed apps.
# Copy to ignored .env.acceptance.local; fill from the staging secret store.
ACCEPTANCE_ENVIRONMENT=staging
ACCEPTANCE_TESTER_ID=
ACCEPTANCE_RELEASE_OWNER_ID=
ACCEPTANCE_PROJECT_REF=
ACCEPTANCE_TARGET_FILE=
HOSTED_SUPABASE_URL=
HOSTED_SUPABASE_PUBLISHABLE_KEY=
# PostgreSQL TLS verification is mandatory: sslmode=verify-full.
# Only for read-only verification and narrowly guarded acceptance provisioning.
HOSTED_DATABASE_URL=
PSQL_PATH=
PLATFORM_ADMIN_ORIGIN=
BUSINESS_APP_ORIGIN=
WEBSITES_ORIGIN=
ACCEPTANCE_ORG_A_ID=
ACCEPTANCE_ORG_B_ID=
ACCEPTANCE_ORG_A_NAME=
ACCEPTANCE_PLATFORM_ADMIN_EMAIL=
ACCEPTANCE_PLATFORM_ADMIN_PASSWORD=
ACCEPTANCE_OWNER_A_EMAIL=
ACCEPTANCE_OWNER_A_PASSWORD=
ACCEPTANCE_USER_A_EMAIL=
ACCEPTANCE_USER_A_PASSWORD=
ACCEPTANCE_OWNER_B_EMAIL=
ACCEPTANCE_OWNER_B_PASSWORD=
ACCEPTANCE_USER_B_EMAIL=
ACCEPTANCE_USER_B_PASSWORD=
ACCEPTANCE_ACCOUNTS_EMAIL=
ACCEPTANCE_ACCOUNTS_PASSWORD=
ACCEPTANCE_PROJECT_MANAGER_EMAIL=
ACCEPTANCE_PROJECT_MANAGER_PASSWORD=
ACCEPTANCE_SITE_SUPERVISOR_EMAIL=
ACCEPTANCE_SITE_SUPERVISOR_PASSWORD=
ACCEPTANCE_STORE_MANAGER_EMAIL=
ACCEPTANCE_STORE_MANAGER_PASSWORD=
ACCEPTANCE_WEBSITE_BROCHURE_EMAIL=
ACCEPTANCE_WEBSITE_BROCHURE_PASSWORD=
# Optional additional existing roles for legacy browser fixtures.
ACCEPTANCE_DESIGNER_EMAIL=
ACCEPTANCE_DESIGNER_PASSWORD=
ACCEPTANCE_SALES_EMAIL=
ACCEPTANCE_SALES_PASSWORD=
ACCEPTANCE_BROWSER=
ACCEPTANCE_SCENARIOS_FILE=
# No service-role credential is required by the runner or applications.
# Reserved for separately reviewed Auth control-plane actions; never a browser key.
HOSTED_SUPABASE_SECRET_KEY=
# Auth SMTP lives in the Supabase control plane. Declaring configured is not PASS.
ACCEPTANCE_SMTP_CONFIGURED=
ACCEPTANCE_INBOX_URL=
ACCEPTANCE_INBOX_TOKEN=
ACCEPTANCE_INBOX_PROVIDER=
ACCEPTANCE_INBOX_SERVER=
ACCEPTANCE_RECOVERY=
ACCEPTANCE_RESET_NEW_PASSWORD=
ACCEPTANCE_PLATFORM_RESET_NEW_PASSWORD=
ACCEPTANCE_SUPABASE_CONTROL_TOKEN=
AUTOMATION_DATABASE_URL=
AUTOMATION_EMAIL_API_KEY=
AUTOMATION_EMAIL_FROM=
ACCEPTANCE_SCHEDULER_CONFIGURED=
ACCEPTANCE_WORKER_CONTROL_URL=
ACCEPTANCE_WORKER_CONTROL_TOKEN=
ACCEPTANCE_MONITORING_URL=
ACCEPTANCE_MONITORING_TOKEN=
ACCEPTANCE_BACKUP_CONTROL_URL=
ACCEPTANCE_BACKUP_CONTROL_TOKEN=
ACCEPTANCE_DEPLOYMENT_CONTROL_URL=
ACCEPTANCE_DEPLOYMENT_CONTROL_TOKEN=
# Optional only: current media uses private database bytes, not an object bucket.
ACCEPTANCE_STORAGE_BUCKET=
# Explicit legacy test opt-ins; never default them in application deployments.
E2E_LIVE_SUPABASE=
E2E_LIVE_CRM=
E2E_LIVE_FINANCE=
E2E_ACCEPTED_REVISION_ID=
E2E_LIVE_EXECUTION=
E2E_EXECUTION_PROJECT_ID=
E2E_EXECUTION_CONTRACT_ID=
E2E_LIVE_OPERATIONS=
E2E_OPERATIONS_PROJECT_ID=
E2E_OPERATIONS_CONTRACT_ID=
E2E_LIVE_AUTOMATION=
E2E_LIVE_BROCHURE=
E2E_BROCHURE_PUBLIC_ORIGIN=
