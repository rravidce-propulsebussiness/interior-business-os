diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..80e76944692ede93fe31d195047a4ba89b752268
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,18 @@
+'use strict';
+
+// Bound the AST before the library's recursive walkers. This traversal is iterative.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  let visited = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || ++visited > 131072) {
+      const error = new SyntaxError('Brace pattern exceeds safe AST bounds');
+      error.code = 'ERR_BRACES_AST_LIMIT';
+      throw error;
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
