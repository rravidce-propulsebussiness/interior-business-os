{
  "name": "business-os",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "automation:worker": "node scripts/automation-worker.mjs",
    "production:start": "node scripts/start-service.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:dependency": "node --test scripts/security-dependency.test.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "acceptance:hosted": "node scripts/acceptance/hosted.mjs",
    "acceptance:preflight": "node scripts/acceptance/hosted.mjs --preflight",
    "acceptance:provision": "node scripts/acceptance/hosted.mjs --provision",
    "acceptance:cleanup": "node scripts/acceptance/hosted.mjs --cleanup",
    "acceptance:performance": "node scripts/acceptance/hosted.mjs --performance",
    "acceptance:reference": "node scripts/acceptance/reference.mjs",
    "test:acceptance": "node --test scripts/acceptance/acceptance.test.mjs",
    "build": "pnpm --workspace-concurrency=1 --filter \"./apps/*\" build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/business-app/src/app/api/admin-access/route.ts apps/business-app/src/proxy.ts docs/HOSTINGER-DEPLOYMENT.md && git diff -- apps/business-app/src/app/api/admin-access/route.ts apps/business-app/src/proxy.ts docs/HOSTINGER-DEPLOYMENT.md && prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm security:client && pnpm security:secrets && pnpm test:e2e",
    "db:verify": "node packages/database/scripts/verify.mjs",
    "db:test": "node packages/database/scripts/test.mjs",
    "db:types": "node packages/database/scripts/generate-types.mjs",
    "db:types:check": "node packages/database/scripts/generate-types.mjs --check",
    "db:seed:check": "node packages/database/scripts/generate-catalog-seed.mjs --check && node packages/database/scripts/generate-crm-seed.mjs --check",
    "security:client": "node scripts/check-client-bundles.mjs",
    "hostinger:build": "node scripts/hostinger-build.mjs",
    "hostinger:start": "node server.js",
    "postinstall": "node scripts/hostinger-postinstall.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
